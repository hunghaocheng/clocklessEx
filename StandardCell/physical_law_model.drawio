  <diagram id="phys-law" name="物理定律模型">
    <mxGraphModel dx="1200" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="物理定律基础模型：内生四大模块 + 两类分路（载荷 / 特征）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=14;fontStyle=1;fontColor=#000000;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="820" height="32" as="geometry"/>
        </mxCell>

        <!-- 平级入口 -->
        <mxCell id="base" value="门级网表基础模型&#xa;（神经元模型 ‖ 物理定律模型 并行衍生）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="320" height="60" as="geometry"/>
        </mxCell>

        <!-- ===== 四大模块 ===== -->
        <mxCell id="modBox" value="基础模型内部衍生 · 四大模块" style="swimlane;startSize=28;horizontal=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;swimlaneFillColor=#f3eaf7;strokeColor=#9673a6;fontColor=#000000;fontStyle=1;fontSize=13;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="1120" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="模块1 观测模块&#xa;&#xa;边界激励 / 变化捕获&#xa;物理：场源注入&#xa;门级：en + latch 快照" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;opacity=100;" vertex="1" parent="modBox">
          <mxGeometry x="25" y="50" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="模块2 势场模块&#xa;&#xa;势差 / 稀疏编码&#xa;物理：梯度·自由度&#xa;门级：掩码 AND / 特征码" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;opacity=100;" vertex="1" parent="modBox">
          <mxGeometry x="300" y="50" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="模块3 相互作用模块&#xa;&#xa;守恒·符合·边调制&#xa;物理：力与反作用&#xa;门级：C元 / weight / mutex" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;opacity=100;" vertex="1" parent="modBox">
          <mxGeometry x="575" y="50" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="模块4 演化模块&#xa;&#xa;状态跃迁 / 发放&#xa;物理：可观测量输出&#xa;门级：spike + req/ack" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;opacity=100;" vertex="1" parent="modBox">
          <mxGeometry x="850" y="50" width="240" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="eBm" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="base" target="modBox" value="内生衍生">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== 两类分路 ===== -->
        <mxCell id="splitBox" value="两类分路（贯穿四大模块）" style="swimlane;startSize=28;horizontal=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;swimlaneFillColor=#fffde7;strokeColor=#d6b656;fontColor=#000000;fontStyle=1;fontSize=13;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1120" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="fork" value="势场模块&#xa;分叉点" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="40" y="100" width="120" height="90" as="geometry"/>
        </mxCell>

        <!-- 特征分路 -->
        <mxCell id="featPath" value="分路 A：特征传递" style="swimlane;startSize=26;horizontal=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;swimlaneFillColor=#eef5fc;strokeColor=#6c8ebf;fontColor=#000000;fontStyle=1;fontSize=12;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="220" y="40" width="840" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="稀疏特征码&#xa;feat_code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;opacity=100;" vertex="1" parent="featPath">
          <mxGeometry x="20" y="40" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="调制边结构&#xa;加强/削弱/选通" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;opacity=100;" vertex="1" parent="featPath">
          <mxGeometry x="200" y="40" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="相互作用模块&#xa;符合·路由依据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;opacity=100;" vertex="1" parent="featPath">
          <mxGeometry x="400" y="40" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="决定输出事务链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;opacity=100;" vertex="1" parent="featPath">
          <mxGeometry x="600" y="40" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="featPath" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="featPath" source="f2" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="fe3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="featPath" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 载荷分路 -->
        <mxCell id="payPath" value="分路 B：载荷传递" style="swimlane;startSize=26;horizontal=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;swimlaneFillColor=#f3eaf7;strokeColor=#9673a6;fontColor=#000000;fontStyle=1;fontSize=12;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="220" y="175" width="840" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="原始 data&#xa;payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;opacity=100;" vertex="1" parent="payPath">
          <mxGeometry x="20" y="40" width="130" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="旁路保持&#xa;payload latch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;opacity=100;" vertex="1" parent="payPath">
          <mxGeometry x="200" y="40" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="等待链路选定&#xa;不参与符合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;opacity=100;" vertex="1" parent="payPath">
          <mxGeometry x="400" y="40" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="沿选中边随事务发出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;opacity=100;" vertex="1" parent="payPath">
          <mxGeometry x="600" y="40" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="payPath" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="payPath" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="payPath" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="sf" value="特征" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#6c8ebf;fontColor=#000000;labelBackgroundColor=#dae8fc;fontStyle=1;" edge="1" parent="splitBox" source="fork" target="featPath">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sp" value="载荷" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#9673a6;fontColor=#000000;labelBackgroundColor=#e1d5e7;fontStyle=1;" edge="1" parent="splitBox" source="fork" target="payPath">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 汇合 -->
        <mxCell id="joinBox" value="演化模块汇合：链路依据 &lt;- 特征分路；事务载荷 &lt;- 载荷分路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="1120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="ej1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="1" source="splitBox" target="joinBox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 原则 -->
        <mxCell id="rule1" value="四大模块：观测 → 势场 → 相互作用 → 演化（图网络节点角色）" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1120" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="rule2" value="两类分路：特征传递塑造边/链路；载荷传递提供事务内容；门级上分属不同线束与握手" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="1120" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="rule3" value="与神经元模型平级：共享四大模块形态与分路机制，语义分别来自认知符合与物理定律，共同落到门级网表" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="1120" height="36" as="geometry"/>
        </mxCell>

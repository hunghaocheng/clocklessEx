<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-07-27T03:00:00.000Z" agent="clocklessEx" version="22.1.0" type="device">
  <diagram id="runtime-mech" name="图网络核心机制">
    <mxGraphModel dx="1200" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="图网络核心：节点(神经元) + 边(relation) ；分路：特征码改边，data 作载荷" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=14;fontStyle=1;fontColor=#000000;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="900" height="32" as="geometry"/>
        </mxCell>

        <!-- ===== 图网络主体 ===== -->
        <mxCell id="graphBox" value="图网络主体（程序 = 拓扑）" style="swimlane;startSize=28;horizontal=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;swimlaneFillColor=#e8f5e9;strokeColor=#82b366;fontColor=#000000;fontStyle=1;fontSize=13;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1120" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="nP" value="节点：外设神经元&#xa;变化检测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;opacity=100;" vertex="1" parent="graphBox">
          <mxGeometry x="40" y="55" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="nF" value="节点：特征神经元&#xa;稀疏特征码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;opacity=100;" vertex="1" parent="graphBox">
          <mxGeometry x="280" y="55" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="nR" value="节点：路由神经元&#xa;关联存储+路由" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;opacity=100;" vertex="1" parent="graphBox">
          <mxGeometry x="520" y="55" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="nO" value="节点：输出神经元&#xa;事务发放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;opacity=100;" vertex="1" parent="graphBox">
          <mxGeometry x="780" y="55" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ePF" value="边" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#e8f5e9;" edge="1" parent="graphBox" source="nP" target="nF">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eFR" value="边" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#e8f5e9;" edge="1" parent="graphBox" source="nF" target="nR">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eRO" value="边(可加权)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#e8f5e9;" edge="1" parent="graphBox" source="nR" target="nO">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="gDef" value="节点 = 神经元门级实例（处理/存储）&#xa;边 = relation 线束 + 权重/连通结构（决定事务往哪走、强不强）" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;opacity=100;" vertex="1" parent="graphBox">
          <mxGeometry x="40" y="150" width="880" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== 分路设计 ===== -->
        <mxCell id="splitBox" value="分路设计（特征码改边 / data 作载荷）" style="swimlane;startSize=28;horizontal=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;swimlaneFillColor=#fffde7;strokeColor=#d6b656;fontColor=#000000;fontStyle=1;fontSize=13;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1120" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="src" value="特征神经元输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="30" y="60" width="120" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="pathF" value="特征码通路&#xa;feat_code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="220" y="40" width="140" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="pathD" value="载荷通路&#xa;data payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="220" y="130" width="140" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="edgeMod" value="作用在边上&#xa;加强 / 削弱 / 选通&#xa;weight / enable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="430" y="35" width="160" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="payHold" value="旁路保持&#xa;payload latch&#xa;等待路由结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="430" y="125" width="160" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="routeN" value="路由神经元&#xa;读边结构决定&#xa;输出事务链路" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="660" y="70" width="150" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="txnOut" value="输出事务&#xa;链路依据&lt;-特征码&#xa;载荷&lt;-data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="880" y="70" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="splitBox" source="src" target="pathF"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="splitBox" source="src" target="pathD"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" value="改边" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#b85450;fontColor=#000000;labelBackgroundColor=#f8cecc;fontStyle=1;" edge="1" parent="splitBox" source="pathF" target="edgeMod">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se4" value="载荷" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#9673a6;fontColor=#000000;labelBackgroundColor=#e1d5e7;" edge="1" parent="splitBox" source="pathD" target="payHold">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se5" value="边结构" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#b85450;fontColor=#000000;labelBackgroundColor=#f8cecc;" edge="1" parent="splitBox" source="edgeMod" target="routeN">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se6" value="附载荷" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#9673a6;fontColor=#000000;labelBackgroundColor=#e1d5e7;" edge="1" parent="splitBox" source="payHold" target="txnOut">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="se7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#000000;" edge="1" parent="splitBox" source="routeN" target="txnOut"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="splitNote" value="特征码不直接当业务数据用，而用来塑造路由神经元的边：加强、削弱或断开某条输出链路；data 仅在链路选定后作为事务载荷跟出。" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;opacity=100;" vertex="1" parent="splitBox">
          <mxGeometry x="30" y="210" width="1050" height="45" as="geometry"/>
        </mxCell>

        <!-- ===== 边结构语义 ===== -->
        <mxCell id="edgeBox" value="路由神经元的边结构（由特征码调制）" style="swimlane;startSize=28;horizontal=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;swimlaneFillColor=#f3eaf7;strokeColor=#9673a6;fontColor=#000000;fontStyle=1;fontSize=13;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="1120" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="rn" value="路由神经元&#xa;中心节点" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="edgeBox">
          <mxGeometry x="420" y="55" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="o1" value="下游A&#xa;边加强" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;opacity=100;" vertex="1" parent="edgeBox">
          <mxGeometry x="160" y="40" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="o2" value="下游B&#xa;边削弱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;opacity=100;" vertex="1" parent="edgeBox">
          <mxGeometry x="160" y="120" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="o3" value="下游C&#xa;边断开" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#000000;opacity=100;" vertex="1" parent="edgeBox">
          <mxGeometry x="700" y="40" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="o4" value="下游D&#xa;边选通" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;opacity=100;" vertex="1" parent="edgeBox">
          <mxGeometry x="700" y="120" width="100" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="ee1" value="w↑" style="html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=3;fontColor=#000000;labelBackgroundColor=#d5e8d4;" edge="1" parent="edgeBox" source="rn" target="o1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ee2" value="w↓" style="html=1;endArrow=classic;dashed=1;strokeColor=#d6b656;fontColor=#000000;labelBackgroundColor=#fff2cc;" edge="1" parent="edgeBox" source="rn" target="o2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ee3" value="w=0" style="html=1;endArrow=classic;dashed=1;strokeColor=#b85450;fontColor=#000000;labelBackgroundColor=#f8cecc;" edge="1" parent="edgeBox" source="rn" target="o3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ee4" value="enable" style="html=1;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;labelBackgroundColor=#dae8fc;" edge="1" parent="edgeBox" source="rn" target="o4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="edgeNote" value="输出事务链路由边结构决定；载荷 data 沿被选中的边发出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#000000;opacity=100;" vertex="1" parent="edgeBox">
          <mxGeometry x="840" y="70" width="250" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== 原则 ===== -->
        <mxCell id="rule" value="原则：图 = 节点 + 边；特征码塑造边；data 填充事务载荷；门级网表实现节点内部与边权重" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontStyle=1;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="1120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="flow" value="外设变化检测 -&gt; 特征抽象(分路) -&gt; 特征码调制路由边 -&gt; 沿选中边输出(data载荷) -&gt; ack 回清" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;opacity=100;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="1120" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
